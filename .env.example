# Copy to .env and fill in real values:
#   cp .env.example .env

# Postgres connection (SQLAlchemy + psycopg)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hrms

# LLM / agents (add when you start LangGraph agents)
# OPENAI_API_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=hrms-agents
